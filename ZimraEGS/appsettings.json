{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DataDirectory": "",
  "ConnectionStrings": {
    "Fiscal": ""
  },

  "Fdms": {
    "SkipServerCertificateValidation": false,
    "TimeoutSeconds": 30
  },

  "AutoCloseDay": {
    "Enabled": true,
    "TimeOfDay": "23:30",
    "CheckIntervalMinutes": 10,
    "HoursBeforeLimit": 1
  }
}
