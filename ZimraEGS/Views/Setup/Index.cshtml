@using ZimraEGS.Helpers
@model ZimraEGS.Models.SetupViewModel
@{
    ViewData["Title"] = "Connect to ZIMRA";
    var back = Utils.SafeReturnUrl(Model.Referrer);
}

<div class="container-fluid setup-container text-start">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7 mb-4">
            <div class="card card-custom">
                <div class="card-header section-header">
                    <h5 class="mb-0">Connect this business to ZIMRA</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Enter the three values ZIMRA gave you for the device. Everything else is set up for you.</p>

                    <form id="setupForm" autocomplete="off">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label" for="deviceId">Device ID</label>
                                <input class="form-control" id="deviceId" inputmode="numeric" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="serialNumber">Serial Number</label>
                                <input class="form-control" id="serialNumber" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="activationKey">Activation Key</label>
                                <input class="form-control" id="activationKey" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="environment">ZIMRA environment</label>
                                <select class="form-select" id="environment">
                                    <option value="Simulation">Test</option>
                                    <option value="Production">Production (live)</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="defaultMoneyType">When an invoice does not say how it was paid, report it as</label>
                                <select class="form-select" id="defaultMoneyType">
                                    <option value="">Do not assume — ask me on the invoice</option>
                                    <option value="0">Cash</option>
                                    <option value="1">Card</option>
                                    <option value="2">Mobile wallet</option>
                                    <option value="4">Credit (not paid yet)</option>
                                    <option value="5">Bank transfer</option>
                                    <option value="6">Other</option>
                                </select>
                                <div class="form-text">You can still choose a payment type on any single invoice. This can be changed later.</div>
                            </div>
                        </div>

                        <details class="mt-3">
                            <summary class="text-muted small">Advanced</summary>
                            <div class="row g-3 mt-0">
                                <div class="col-sm-6">
                                    <label class="form-label" for="modelName">Device model name</label>
                                    <input class="form-control" id="modelName" value="Server" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label" for="modelVersion">Device model version</label>
                                    <input class="form-control" id="modelVersion" value="v1" />
                                </div>
                            </div>
                        </details>

                        <div id="message" class="alert d-none mt-3 mb-0" role="alert"></div>

                        <div id="taxpayer" class="border rounded p-3 mt-3 d-none">
                            <div class="text-muted small">ZIMRA says this device belongs to</div>
                            <div class="fw-bold" id="taxpayerName"></div>
                            <div id="taxpayerDetails" class="small"></div>
                        </div>

                        <ul id="steps" class="list-unstyled mt-3 mb-0 d-none">
                            <li data-step="register">Register the device with ZIMRA</li>
                            <li data-step="records">Create the custom fields, tax codes and invoice theme in Manager</li>
                            <li data-step="business">Link the business to the device</li>
                        </ul>

                        <hr />
                        <div class="d-flex flex-wrap gap-2 justify-content-between">
                            <a class="btn btn-secondary btn-sm @(string.IsNullOrEmpty(back) ? "disabled" : "")" href="@back" id="backToManager">Back to Manager</a>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="changeButton">Change details</button>
                                <button type="submit" class="btn btn-primary btn-sm" id="actionButton">Check device</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var api = @Html.Raw(Utils.ToScriptJson((Model.Api ?? "").TrimEnd('/')));
            var token = @Html.Raw(Utils.ToScriptJson(Model.Token));
            var businessDetailsJson = @Html.Raw(Utils.ToScriptJson(Model.BusinessDetailsJson));
            var back = @Html.Raw(Utils.ToScriptJson(back));

            var $ = function (id) { return document.getElementById(id); };
            var inputs = ['deviceId', 'serialNumber', 'activationKey', 'environment', 'modelName', 'modelVersion'];
            var phase = 'check';     // check -> confirm -> done
            var setup = null;        // answer of the server once the device is registered

            function message(kind, text) {
                $('message').className = 'alert mt-3 mb-0 alert-' + kind;
                $('message').textContent = text;
            }
            function clearMessage() { $('message').className = 'alert d-none mt-3 mb-0'; }

            function step(name, state) {
                var li = document.querySelector('[data-step="' + name + '"]');
                var mark = { doing: '… ', done: '✓ ', failed: '✗ ' }[state] || '';
                li.textContent = mark + li.textContent.replace(/^[…✓✗] /, '');
                li.className = state === 'done' ? 'text-success' : state === 'failed' ? 'text-danger' : '';
            }

            function request() {
                var money = $('defaultMoneyType').value;
                return {
                    IntegrationType: $('environment').value,
                    DeviceID: parseInt($('deviceId').value, 10) || 0,
                    DeviceSerialNumber: $('serialNumber').value.trim(),
                    ActivationKey: $('activationKey').value.trim(),
                    DeviceModelName: $('modelName').value.trim(),
                    DeviceModelVersion: $('modelVersion').value.trim(),
                    DefaultMoneyType: money === '' ? null : parseInt(money, 10),
                    Api: api,
                    BusinessDetailsJson: businessDetailsJson
                };
            }

            async function post(url, body) {
                var response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
                var data = null;
                try { data = await response.json(); } catch (e) { }
                if (!response.ok) throw new Error((data && (data.Error || data.error)) || ('The server answered ' + response.status));
                return data;
            }

            async function putToManager(url, body) {
                var response = await fetch(url, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: body
                });
                if (!response.ok) throw new Error('Manager answered ' + response.status + ' for ' + url);
            }

            function lock(locked) {
                inputs.forEach(function (id) { $(id).disabled = locked; });
            }

            async function check() {
                var info = await post('@Url.Action("VerifyTaxPayerInformation")', request());
                var address = info.deviceBranchAddress || {};
                $('taxpayerName').textContent = info.taxPayerName || '';
                $('taxpayerDetails').textContent = [
                    info.taxPayerTIN ? 'TIN ' + info.taxPayerTIN : '',
                    info.vatNumber ? 'VAT ' + info.vatNumber : '',
                    info.deviceBranchName,
                    [address.houseNo, address.street, address.city].filter(Boolean).join(' ')
                ].filter(Boolean).join(' · ');
                $('taxpayer').classList.remove('d-none');
                lock(true);
                phase = 'confirm';
                $('actionButton').textContent = 'Yes, connect this business';
                $('changeButton').classList.remove('d-none');
            }

            async function finish() {
                $('steps').classList.remove('d-none');
                $('changeButton').classList.add('d-none');

                // Registering is done once; a retry of the Manager steps reuses the result.
                if (!setup) {
                    step('register', 'doing');
                    try { setup = await post('@Url.Action("Complete")', request()); }
                    catch (e) { step('register', 'failed'); throw e; }
                }
                step('register', 'done');

                step('records', 'doing');
                try {
                    var forms = Object.keys(setup.Records);
                    for (var f = 0; f < forms.length; f++) {
                        var items = setup.Records[forms[f]];
                        for (var i = 0; i < items.length; i++) {
                            await putToManager(api + '/' + forms[f] + '/key/' + encodeURIComponent(items[i].Key), JSON.stringify(items[i]));
                        }
                    }
                } catch (e) { step('records', 'failed'); throw e; }
                step('records', 'done');

                step('business', 'doing');
                try { await putToManager(setup.Business.ApiUrl, setup.Business.Payload); }
                catch (e) { step('business', 'failed'); throw e; }
                step('business', 'done');

                phase = 'done';
                message('success', 'All set. Go back to Manager and click Relay on an invoice to fiscalise it.');
                $('actionButton').classList.add('d-none');
                $('backToManager').className = 'btn btn-primary btn-sm' + (back ? '' : ' disabled');
            }

            $('changeButton').addEventListener('click', function () {
                phase = 'check';
                lock(false);
                clearMessage();
                $('taxpayer').classList.add('d-none');
                $('changeButton').classList.add('d-none');
                $('actionButton').textContent = 'Check device';
            });

            $('setupForm').addEventListener('submit', async function (event) {
                event.preventDefault();
                var button = $('actionButton');
                button.disabled = true;
                clearMessage();
                try {
                    if (phase === 'check') await check(); else if (phase === 'confirm') await finish();
                } catch (e) {
                    message('danger', e.message + (phase === 'confirm' ? ' Click the button to try again.' : ''));
                    if (phase === 'confirm') button.textContent = 'Try again';
                } finally {
                    button.disabled = false;
                }
            });
        })();
    </script>
}
